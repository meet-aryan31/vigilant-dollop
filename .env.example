# Fallback chain of provider/model pairs, tried left to right.
# Each model gets exactly 1 attempt; on any error it falls through to the next.
# Example: p1m1 -> p1m2 -> p2m1 -> p2m2 -> p2m3
LLM_CHAIN=openai/gpt-4o-mini,openai/gpt-4o,anthropic/claude-3-5-sonnet-20241022,groq/llama-3.1-70b-versatile

# API keys per provider (comma-separated provider=key pairs)
LLM_API_KEYS=openai=sk-your-openai-key,anthropic=sk-ant-your-anthropic-key,groq=gsk_your-groq-key,gemini=AQ.....

# Default system prompt (documents: pdf / txt / docx)
LLM_SYSTEM_PROMPT=You are a helpful assistant. Summarize and answer questions about the provided text clearly and concisely.

# Per-file-type system prompts (selected by extension)
# Images: png jpg jpeg bmp tif tiff webp
prompt_img=You are an image analysis expert. Extract all visible text (OCR) and describe every element in the image in detail, in markdown.

# Videos: mp4 mov avi mkv m4v mpg mpeg wmv flv
prompt_video=You are a video analysis expert. Summarize what happens in this video, list scenes in order, and quote any spoken dialogue.

# Audio: mp3 wav m4a flac ogg webm aac wma
prompt_audio=You are an audio analysis expert. Summarize the recording: identify the topic, key points, speakers, and tone.

# Sampling temperature (0.0 - 2.0)
LLM_TEMPERATURE=0.7

# Maximum response length in tokens
LLM_MAX_TOKENS=2048

# Whisper model used for audio files (tiny | base | small | medium | large)
WHISPER_MODEL=base

# Fraud-detection system prompt (audio uploads always run this flow)
prompt_fraud=You are a call-verification analyst. The user text is a timestamped transcript of a phone call in English, Hindi, or mixed (Hinglish). Decide whether the caller is a fraudster. Watch for demands for OTP, PIN, card or account details; impersonation of bank, support, or government staff; threats or false urgency; gift-card or money-transfer requests; tech-support scams; phishing links; and requests to share verification codes. Respond with ONLY a valid JSON object and no other text, in exactly this shape: {"verdict": "fraud" or "legit", "confidence": 0.0 to 1.0, "reason": "2-4 sentences quoting the transcript verbatim with [mm:ss] timestamps as evidence"}. The reason must be grounded only in words present in the transcript - never invent speakers, events, or words. Transcripts may contain speech-recognition errors; quote exactly what appears.

# Temperature for the fraud verdict call (keep low for deterministic classification)
FRAUD_TEMPERATURE=0.1

# STT provider: auto (groq then local), groq, or local
STT_PROVIDER=auto
# STT language: auto, hi, en (auto handles code-mixed Hindi/English best)
STT_LANGUAGE=auto

# Deployment
# Comma-separated origins allowed to call this API from a SEPARATE frontend.
# e.g. FRONTEND_ORIGINS=https://your-app.vercel.app  (* for dev only - lock it down in prod)
FRONTEND_ORIGINS=*
# Local dev only. On a host like Render/Railway set FLASK_DEBUG=0 and use: gunicorn app:app
FLASK_DEBUG=0
# HOST=0.0.0.0
# PORT=5000
